node_modules/
dist/
coverage/
*.log

# Dev-only secrets: never commit certs, private keys, or local .env files
infra/mosquitto/certs/
backend/.env
*.key
*.pem
firmware/main/certs/
# Real client licence data (org name, device limits, signature) -- environment-
# specific, not source. Note *.pem above already covers licence/public_key.pem.
backend/licence/licence.json

# ESP-IDF build output and downloaded managed components -- regenerated by
# `idf.py build`, not source (found 2026-11-11: neither was previously ignored).
build/
**/build/
**/managed_components/
**/.cache/
firmware/build/
firmware/managed_components/

# Ad-hoc debug scratch output (curl/serial dumps saved while bench-testing) --
# found 2026-11-11 sitting in firmware/_gate/ with a real (if since-expired)
# JWT access/refresh token pair. Keep the actual *.py/*.ps1 bench tools in that
# directory; just don't let their throwaway JSON output get committed again.
firmware/_gate/*.json
tools/tmp_*.json

# OS/editor noise
.DS_Store
Thumbs.db

# Compiled test host binaries -- regenerated by test_host/run_tests.ps1
firmware/test_host/*.exe

# Snowflake Cortex IDE plan artifacts (not part of the project)
.snowflake/
