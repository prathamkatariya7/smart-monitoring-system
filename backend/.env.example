# Copy to .env and fill in for local/dev use. No cloud services, no paid APIs — everything runs locally via Docker Compose.

NODE_ENV=development
PORT=3000

# Postgres / TimescaleDB
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=rmp_app
DB_PASSWORD=change_me_dev_password
DB_DATABASE=rmp
DB_SSL=false
# Superuser creds, used only by the migration runner (DDL/GRANT); never used by the app at runtime.
MIGRATION_DB_USERNAME=postgres
MIGRATION_DB_PASSWORD=change_me_dev_superuser_password

# Auth
JWT_ACCESS_SECRET=change_me_dev_access_secret_please_rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please_rotate
JWT_REFRESH_TTL=7d
MFA_ISSUER=ReactorMonitoringPlatform

# MQTT (backend connects as its own mTLS client, CN=rmp-backend -- separate
# from the broker's own server.crt/server.key and from device certs)
MQTT_URL=mqtts://mosquitto:8883
MQTT_CA_PATH=/certs/ca.crt
MQTT_CERT_PATH=/certs/backend.crt
MQTT_KEY_PATH=/certs/backend.key
MQTT_CLIENT_ID=rmp-backend

# Single-tenant install defaults (first-run wizard will overwrite via DB)
INSTALL_ORG_NAME=Default Organisation
INSTALL_EDITION=solo
INSTALL_POLICY_PACK=flexible

# Licence (offline, signature verified with a public key baked into the app — see licence module)
LICENCE_FILE_PATH=/licence/licence.json
LICENCE_PUBLIC_KEY_PATH=/licence/public_key.pem

# Backup (Part 9.8)
BACKUP_DIR=/app/backups
